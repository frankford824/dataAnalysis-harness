    "group": "12px 7px 14px 8px / 9px 13px 8px 12px"
  },
  "shadows": {"rest": "1px 2px 0 var(--sk-color-shadow)", "raised": "2px 6px 0 var(--sk-color-shadow), 0 12px 20px var(--sk-color-shadow)", "sheet": "2px 3px 0 var(--sk-color-shadow), 0 16px 32px var(--sk-color-shadow)"},
  "geometry": {"sidebar": 176, "sidebar-compact": 156, "scope-picker": 128, "content-min": 648, "mobile-min": 480, "control-height": 40, "touch-height": 44, "row-height": 48, "object-body": 80, "object-header": 44, "object-grip": 40, "group-header": 64, "pending-min": 170, "group-min": 208, "group-inset": 16, "group-footer": 48, "group-selector": 128, "board-label": 40, "board-min": 440, "drawer-width": 440, "file-width": 240, "labor-width": 352, "labor-input": 192, "floating-width": 272, "table-min": 620, "store-cell": 92, "org-min": 128},
  "sketch": {"roughness": 0.75, "seed": 7, "frequency": 0.025, "traceOpacity": 0.14, "rule": "固定种子的轮廓复描，仅作用于边缘；文字和数值不做扭曲"},
  "motion": {"paper-stiffness": 240, "paper-damping": 23, "group-stiffness": 170, "group-damping": 22, "evidence-stiffness": 270, "evidence-damping": 25, "navigation-stiffness": 220, "navigation-damping": 26, "release-inertia": 1, "hover-duration": "180ms"},
  "blocks": {"order": ["hero", "function", "display"], "hero": "当前任务、店铺账期与简短说明，标题最多两行", "function": "本区块的操作和选择，最多一个主按钮", "display": "结果、明细与原始依据；金额对齐，缺值与零明确区分"},
  "components": {
    "button": {"height": "geometry.control-height", "text": "type.body", "padding": "space.2 / space.3", "states": ["默认", "悬停", "按下", "焦点", "禁用"], "rule": "主按钮只表示当前任务的下一步；全局工具使用次按钮"},
    "table": {"row": "geometry.row-height", "header": "type.caption", "body": "type.body", "rule": "金额右对齐、等宽数字；保留完整金额；行操作继续可点击"},
    "paper": {"edge": "radius.paper", "stroke": "stroke.paper", "shadow": "shadows.rest", "rule": "轻微复描轮廓，正文不扭曲；拖动时抬起，松手减速落位"},
    "group": {"edge": "radius.group", "rule": "同一店铺账期内临时归组；每条记录与依据保留，可抽出、拆开及撤回"},
    "field": {"height": "geometry.control-height", "text": "type.body", "rule": "标签常显；错误与禁用不能只靠颜色区分"},
    "evidence": {"rule": "从原对象展开，保留文件和行号；只读原始依据与修改草稿分开"},
    "motion": {"rule": "允许途中接管和反向；Esc 取消当前手势；支持减少动态效果"}
  },
  "compatibility": {
    "navigation": ["总览", "数据与店铺", "提成", "费项", "运费复核", "兼职人工费用"],
    "defaultOverview": "明细表",
    "optionalOverview": "账册视图",
    "rules": ["保留原导航名称和业务顺序，新增工作台与规范放到单独区域", "点击、键盘与拖动通向同一结果，不强迫老用户学习手势", "金额、日期、行号不使用手写字体，不随材质挤压变形", "表格默认可用，账册视图可切换并记住选择", "利润标签写明托管范围与兼职是否已扣，不依赖提示说明", "确认结账独立于临时归组；已封存金额保持稳定"]
  }
}
